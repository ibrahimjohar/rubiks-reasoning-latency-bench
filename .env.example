# Copy this file to .env and fill in your real key. Never commit .env.
# The key is only read by the backend; it is never sent to the browser.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Name and roll number shown on every screen (required for the recording)
STUDENT_NAME=Ibrahim Johar Farooqi
STUDENT_ROLL=23K-0074

# ---- Game rules (identical for every model) ----
MAX_MOVES=30

# ---- Request policy (identical for every model) ----
REQUEST_TIMEOUT_SECONDS=60
# Retries happen only on timeouts, network errors, HTTP 408/429/5xx. Never on bad answers.
MAX_RETRIES=1
RETRY_BACKOFF_SECONDS=2

# ---- Claude Opus 5.5 (frontier LLM) ----
OPUS_REASONING_EFFORT=low
# Ceiling for reasoning + answer tokens
OPUS_MAX_TOKENS=1024
# JSON schema with the 18 moves as an enum. Set false only if the route rejects it.
OPUS_STRUCTURED_OUTPUT=true

# ---- Cost guardrail ----
# A run stops before any new request once reported spend reaches this (USD).
# Also set a credit limit on the OpenRouter key itself as the hard cap.
RUN_BUDGET_USD=2.00
